# Copy to .env and fill in. Never commit .env.
# Port for this project's TrueForge instance
TRUEFORGE_PORT=8791
# Model provider key (added in TrueForge UI → Settings → Models, or via API)
OPENAI_API_KEY=
# Fine-grained GitHub token scoped to the demo repo only
GITHUB_TOKEN=
# Daytona API key (needs Snapshots write permission)
DAYTONA_API_KEY=
# Target app repo the agent checks (fork payments-demo and put yours here)
DEMO_REPO=oplatechie/payments-demo
