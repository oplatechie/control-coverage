# Copy to .env and fill in. Never commit .env.
# Port for this project's TrueForge instance
TRUEFORGE_PORT=8791
# Format: KEY=value, no spaces around =, no quotes
# Model provider key
OPENAI_API_KEY=
# Fine-grained GitHub token scoped to the demo repo only
GITHUB_TOKEN=
# Daytona API key (needs Snapshots write permission)
DAYTONA_API_KEY=
# Target app repo the agent checks (fork payments-demo and put yours here)
DEMO_REPO=oplatechie/payments-demo
# Optional: source of record for controls (https URL or file path). Default: bundled controls.yaml
# CONTROLS_SOURCE=
# Optional: controls-mcp port (also change trueforge/mcp-servers.json)
# CONTROLS_MCP_PORT=8801
